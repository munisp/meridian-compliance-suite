<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice form: NRS tab -->
    <record id="view_move_form_inherit_nrs" model="ir.ui.view">
        <field name="name">account.move.form.nrs</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_nrs_submit" type="object"
                        string="Submit to NRS" class="btn-primary"
                        invisible="move_type not in ('out_invoice','out_refund')
                                   or state != 'posted'
                                   or nrs_clearance_status == 'confirmed'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page id="nrs_tab" name="nrs" string="NRS e-Invoicing"
                      invisible="move_type not in ('out_invoice','out_refund')">
                    <group>
                        <group string="Clearance">
                            <field name="nrs_irn" readonly="1"/>
                            <field name="nrs_clearance_status" readonly="1"/>
                            <field name="nrs_payment_status" readonly="1"/>
                            <field name="nrs_last_error" readonly="1"
                                   invisible="not nrs_last_error"/>
                        </group>
                        <group string="Verification QR">
                            <field name="nrs_qr_payload" readonly="1"
                                   widget="text" invisible="not nrs_qr_payload"/>
                        </group>
                    </group>
                    <group string="Submission Log">
                        <field name="nrs_log_ids" readonly="1">
                            <list>
                                <field name="create_date"/>
                                <field name="state"/>
                                <field name="irn"/>
                                <field name="attempts"/>
                                <field name="event"/>
                                <field name="last_error"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Invoice list: clearance status column -->
    <record id="view_invoice_tree_inherit_nrs" model="ir.ui.view">
        <field name="name">account.move.list.nrs</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="payment_state" position="after">
                <field name="nrs_clearance_status" optional="show"/>
                <field name="nrs_irn" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Filter: NRS status grouping on customer invoices -->
    <record id="view_account_invoice_filter_nrs" model="ir.ui.view">
        <field name="name">account.move.search.nrs</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='payment']" position="after">
                <filter name="nrs_failed" string="NRS Failed"
                        domain="[('nrs_clearance_status','=','failed'),
                                 ('move_type','in',('out_invoice','out_refund'))]"/>
            </xpath>
            <xpath expr="//groupby[@name='payment_state']" position="after">
                <filter name="groupby_nrs_clearance" string="NRS Clearance"
                        context="{'group_by': 'nrs_clearance_status'}"/>
            </xpath>
        </field>
    </record>
</odoo>
